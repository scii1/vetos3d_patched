# VetOs 3D Enhanced .gitignore

# Çalışma ve geçici dizinler (Büyük dosyalar / ham çıktılar)
backup/
work/
tools/
decompiled/
extracted/
bin/
obj/
*.user
*.suo
.vs/
.idea/

# GitHub Actions ve Cloud Build Arşivlerinin Git Tarafından Takip Edilmesini Garantiye Al
!cloud_build/
!cloud_build/archive/
!cloud_build/archive/ExportedProject.7z.*
!.github/
!.github/workflows/
!.github/workflows/*.yml
